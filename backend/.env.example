# ============================================================
# Lunaris 后端环境变量模板
# 复制为 .env 并填入你的真实值
# ============================================================

# ---- 数据库（asyncpg 驱动）----
# 格式: postgresql+asyncpg://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgresql+asyncpg://lunaris:your_strong_password@localhost:5432/lunaris_db

# ---- 认证 ----
# JWT_SECRET: 随机生成的 64 字符十六进制字符串
# 生成方法: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_random_jwt_secret_here
JWT_EXPIRE_DAYS=30

# ---- 加密密钥（用于 at-rest 加密敏感数据）----
# ENCRYPTION_KEY: 256-bit 加密密钥（64 字符十六进制）
# 生成方法: python3 -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=your_random_encryption_key_here

# ---- 外部 LLM（DeepSeek）----
# 从 https://platform.deepseek.com 获取你的 API Key
DEEPSEEK_API_KEY=sk-your-actual-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# ---- 语音 / 图片 ----
WHISPER_API_KEY=
TTS_API_KEY=
IMAGE_API_KEY=

# ---- 长期记忆语义检索 embedding ----
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# ---- 热点 RSS（RSSHub，逗号分隔）----
RSS_FEED_URLS=https://rsshub.app/douban/movie/latest,https://rsshub.app/36kr/newsflashes

# ---- 危机干预 ----
CRISIS_HOTLINES=北京心理危机研究与干预中心:010-82951332,希望24热线:400-161-9995
CRISIS_WORDS_FILE=backend/data/crisis_words.txt

# ---- 实时通信 ----
WS_PING_INTERVAL=30

# ---- CORS 跨域配置 ----
# 逗号分隔的允许来源列表
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000

# ---- 速率限制 ----
RATE_LIMIT_PER_MIN=60

# ---- 内容安全 ----
# 是否启用 DeepSeek 语义审核（会增加成本）
ENABLE_SEMANTIC_SCAN=false

# ---- 邮件通知（可选，用于危机升级和管理员通知）----
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
ADMIN_EMAIL=

# ---- 数据保留策略 ----
# 危机事件多少天后自动删除（0 = 永不删除）
CRISIS_DATA_RETENTION_DAYS=30

# ---- 日志级别 ----
LOG_LEVEL=INFO
