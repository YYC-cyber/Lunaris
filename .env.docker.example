# ============================================================
# Lunaris Docker 部署环境变量模板
# 用法：cp .env.docker.example .env.docker，填入真实值后再启动
# 注意：.env.docker 含密钥，已被 .gitignore 忽略，请勿提交
# ============================================================

# ---------- PostgreSQL ----------
POSTGRES_USER=lunaris
POSTGRES_PASSWORD=请修改为强密码
POSTGRES_DB=lunaris_db

# ---------- Redis ----------
REDIS_PASSWORD=请修改为强密码

# ---------- 应用密钥 ----------
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=

# ---------- DeepSeek（对话大模型） ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# ---------- Embedding（向量嵌入，如硅基流动） ----------
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# ---------- 运行参数 ----------
LOG_LEVEL=INFO
ENABLE_SEMANTIC_SCAN=false
# 生产环境务必设为 production
ENVIRONMENT=production

# ---------- 前端 ----------
# 留空则使用相对路径（同源部署）；独立部署时填后端地址，如 https://api.example.com
VITE_API_BASE=
